  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innocencecode/harness-core": "*",
    "@innocencecode/plugin-mcp": "*",
    "@innocencecode/plugin-skills": "*",
    "@innocencecode/plugin-subagent": "*",
    "@innocencecode/provider-anthropic": "*",
    "@innocencecode/provider-mock": "*",
    "@innocencecode/provider-openai": "*",
    "@innocencecode/tools-fs": "*",
    "@innocencecode/tools-shell": "*"
  }
}
